API_ORIGIN="http://localhost:3001"
NEXT_PUBLIC_CHECKOUT_ENABLED=true
# This site's public origin, no trailing slash: canonical links, sitemap.xml, robots.txt and
# the structured data on course pages all name it. Baked in at build.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Extra hosts that images, video, HLS and presigned uploads may use, space separated. Media
# and uploads served through this site's own /api (the demo drivers) need none, so leave it
# blank locally. Read at build and start; a wildcard or a path is refused. Production
# (STORAGE_DRIVER=r2, VIDEO_DRIVER=cloudflare) needs exactly these four, from the API's env:
#   origin of R2_PUBLIC_BASE_URL     covers, e.g. https://media.your-domain.com or https://pub-<HASH>.r2.dev
#   origin of R2_ENDPOINT            presigned PUT uploads, https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   https://videodelivery.net        the playback URL the API signs; hls.js fetches its playlists
#   https://customer-<CODE>.cloudflarestream.com   the account's Stream domain (Stream > dashboard)
# CSP_MEDIA_ORIGINS="https://media.your-domain.com https://<ACCOUNT_ID>.r2.cloudflarestorage.com https://videodelivery.net https://customer-<CODE>.cloudflarestream.com"
CSP_MEDIA_ORIGINS=""
# Server only, never NEXT_PUBLIC_: the same value as the API's INTERNAL_API_SECRET. Sent
# with the visitor's IP (X-Real-IP, trusted only behind a known reverse proxy) on
# server-side API calls and the /api rewrite. Required in production; blank locally is fine.
INTERNAL_API_SECRET=""
