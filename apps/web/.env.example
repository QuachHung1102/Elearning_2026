API_ORIGIN="http://localhost:3001"
NEXT_PUBLIC_CHECKOUT_ENABLED=true
# This site's public origin, no trailing slash: canonical links, sitemap.xml, robots.txt and
# the structured data on course pages all name it. Baked in at build.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Extra hosts that images, video, HLS and presigned uploads may use, space separated (the
# R2 public URL and upload host, the Cloudflare Stream playback host https://videodelivery.net
# or its customer domain; hls.js fetches playlists and segments from it). Media and uploads
# served through this site's own /api need none. Read at build and start; a wildcard or a
# path is refused.
CSP_MEDIA_ORIGINS=""
# Server only, never NEXT_PUBLIC_: the same value as the API's INTERNAL_API_SECRET. Sent
# with the visitor's IP (Railway's X-Real-IP) on server-side API calls and the /api
# rewrite. Required when RAILWAY_ENVIRONMENT_NAME=production; blank elsewhere is fine.
INTERNAL_API_SECRET=""
