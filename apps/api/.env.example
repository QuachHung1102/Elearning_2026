# Core
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elearning"
PORT=3001
NODE_ENV=development
# One JSON line per finished request on stdout (method, path, status, ms, requestId, userId).
LOG_REQUESTS=true
# PASSWORD_HASH_COST exists for .env.test only (cheap hashing for the e2e suite); the API
# refuses to boot in production with it set, whatever the value. Leave it out here.
TZ="Asia/Ho_Chi_Minh"
AUTH_JWT_SECRET=""
WEB_ORIGIN="http://localhost:3000"
API_PUBLIC_URL="http://localhost:3000"

# Drivers: demo | real provider
VIDEO_DRIVER=demo
STORAGE_DRIVER=demo
MAIL_DRIVER=demo
PAYMENT_DRIVER=demo

# Demo
DEMO_VIDEO_FILE="assets/demo/sample.mp4"
DEMO_VIDEO_DURATION_SECONDS=60
STORAGE_LOCAL_DIR=".storage"
LOCAL_MAIL_DIR=".mail"

# Cloudflare Stream [PROD]
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_STREAM_SIGNING_KEY_ID=""
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=""
PLAYBACK_TOKEN_TTL_SECONDS=3600

# Cloudflare R2 [PROD]
R2_ENDPOINT=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BASE_URL=""
SIGNED_FILE_TTL_SECONDS=300
MAX_UPLOAD_BYTES=52428800

# Email
SMTP_URL=""
MAIL_FROM="E-learning <no-reply@your-domain.com>"
EMAIL_VERIFY_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=60

# ZaloPay [PROD]
# PAYMENT_DRIVER=demo needs none of these (key2 falls back to a fixed demo value).
# PAYMENT_DRIVER=zalopay refuses to boot without APP_ID, KEY1, KEY2 and CALLBACK_URL.
ZALOPAY_APP_ID=""
ZALOPAY_KEY1=""
ZALOPAY_KEY2=""
ZALOPAY_ENDPOINT="https://sb-openapi.zalopay.vn/v2"
ZALOPAY_CALLBACK_URL="https://your-domain.com/api/v1/payments/zalopay/callback"
CHECKOUT_QR_TTL_MINUTES=15
RECONCILE_INTERVAL=60
RECONCILE_MIN_AGE=120

# Shared with the web service (same value on both). The web server sends it with the
# visitor's IP so rate limits count visitors, not the web server. Required in production
# (at least 32 bytes); outside production a fixed development value is used.
INTERNAL_API_SECRET=""
