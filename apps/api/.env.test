DATABASE_URL="postgresql://elearning_test:elearning_test@localhost:5432/elearning_test"
NODE_ENV=test
AUTH_JWT_SECRET="test-only-secret-at-least-32-bytes-long"
WEB_ORIGIN="http://localhost:3000"
API_PUBLIC_URL="http://localhost:3001"
TRUST_X_REAL_IP=true
VIDEO_DRIVER=demo
STORAGE_DRIVER=demo
MAIL_DRIVER=demo
PAYMENT_DRIVER=demo
LOCAL_MAIL_DIR=".mail/test"
# One JSON line per request would bury the test output; logging.e2e-spec.ts turns it on for itself.
LOG_REQUESTS=false

# Hash passwords at a cost the e2e suite can afford; the boot guard refuses this in production.
PASSWORD_HASH_COST=test

# The reconcile job fires on its own every RECONCILE_INTERVAL; a test calls runOnce() itself,
# so the timer must never fire in the middle of one.
RECONCILE_INTERVAL=86400
